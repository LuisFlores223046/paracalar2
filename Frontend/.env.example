# ============================================
# Variables de Entorno - Frontend BeFit
# ============================================
# Copia este archivo a .env y configura tus valores

# URL del Backend API
# En desarrollo local, usa: http://localhost:8000
# En producción (Amplify), usa: https://befitapi.store
VITE_API_BASE=https://befitapi.store

# Clave pública de Stripe (Frontend)
# Obtén tu clave en: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLIC_KEY=pk_test_tu_clave_publica_aqui

# ============================================
# INSTRUCCIONES PARA AMPLIFY
# ============================================
#
# 1. Ve a AWS Amplify Console
# 2. Selecciona tu app
# 3. Ve a "App settings" → "Environment variables"
# 4. Agrega las siguientes variables:
#
#    Key: VITE_API_BASE
#    Value: https://befitapi.store
#
#    Key: VITE_STRIPE_PUBLIC_KEY
#    Value: pk_test_51RIP5qB0vBm8XsikGndnz0UL593qTgV97ZZvIuA4FZkjtLRRreTZUdkr28DOBsqSaGp5lWbQf8S4tSDE84e1ohU900Db7HA6F5
#
# 5. Re-despliega la aplicación
# 6. Verifica en la consola del navegador:
#    console.log(import.meta.env.VITE_API_BASE)
#
