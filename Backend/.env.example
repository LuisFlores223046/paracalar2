# ============================================
# Variables de Entorno - Backend BeFit
# ============================================
# Copia este archivo a .env y configura tus valores

# ============ APLICACIÓN ============
APP_NAME="BeFit API"
APP_VERSION="1.0.0"
DEBUG=False
DEV_MODE=False

# ============ BASE DE DATOS ============
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# ============ AWS ============
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tu_access_key_id
AWS_SECRET_ACCESS_KEY=tu_secret_access_key

# ============ AWS COGNITO ============
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=tu_client_id

# ============ AWS S3 ============
S3_BUCKET_NAME=nombre-de-tu-bucket

# ============ JWT ============
JWT_SECRET_KEY=tu_secret_key_o_dejar_vacio
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============ STRIPE ============
STRIPE_API_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ============ PAYPAL ============
PAYPAL_CLIENT_ID=tu_client_id
PAYPAL_CLIENT_SECRET=tu_client_secret
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# ============ CORS ============
# IMPORTANTE: Agrega la URL de tu frontend de Amplify aquí
# Ejemplo: ["https://main.d34s9corpodswj.amplifyapp.com","http://localhost:5173"]
BACKEND_CORS_ORIGINS=["https://main.d34s9corpodswj.amplifyapp.com","http://localhost:5173","http://localhost:3000"]

# URL del frontend para redirecciones (success/cancel de checkout)
# Debe ser la URL de Amplify en producción
APP_URL=https://main.d34s9corpodswj.amplifyapp.com

# ============================================
# INSTRUCCIONES CRÍTICAS PARA AMPLIFY
# ============================================
#
# ⚠️  PASO CRÍTICO: Configurar CORS
#
# Para que el frontend en Amplify pueda conectarse al backend,
# DEBES agregar la URL de Amplify a BACKEND_CORS_ORIGINS:
#
# 1. Obtén tu URL de Amplify (ejemplo):
#    https://main.d34s9corpodswj.amplifyapp.com
#
# 2. Agrégala a BACKEND_CORS_ORIGINS:
#    BACKEND_CORS_ORIGINS=["https://main.TU-APP.amplifyapp.com","http://localhost:5173"]
#
# 3. Actualiza APP_URL con la misma URL:
#    APP_URL=https://main.TU-APP.amplifyapp.com
#
# 4. Reinicia el servidor backend
#
# 5. Verifica en los logs que aparezca:
#    "CORS Origins configurados: ['https://main.TU-APP.amplifyapp.com', ...]"
#
# Sin esto, verás "Failed to fetch" en Amplify
#
